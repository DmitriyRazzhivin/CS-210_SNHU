# macOS System Files
.DS_Store

# VS Code Settings (Optional)
# Keep tasks/launch configurations, but ignore user-specific state
.vscode/.DS_Store
.vscode/ipch/

# C++ Compiled Binaries (Executable files)
# Matches files with no extension (common on Mac)
*
!*.cpp
!*.h
!*.hpp
!*.json
!*.gitignore
!*.md

# Mac Debug Symbols
*.dSYM/
